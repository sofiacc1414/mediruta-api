# Copia este archivo a .env y completa los valores reales localmente.
# .env NUNCA se commitea (ver .gitignore) ni se pega en chats.

# Connection string de Postgres del proyecto Supabase.
# Formato: postgresql://postgres:<password>@<host>:<port>/postgres
# La consigues en: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=

# JWT propio (autenticación custom, ver DOCS/context.md sección 4.1)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
# JWT_REFRESH_EXPIRES_IN también define el maxAge de la cookie HttpOnly del
# refresh token en el flujo Web (ver refresh-cookie.ts) — no hay una
# variable separada para eso, se derivan del mismo valor.
JWT_REFRESH_EXPIRES_IN=7d

# Pepper HMAC-SHA256 del OTP de recuperación (G05). Distinto de JWT_SECRET
# y JWT_REFRESH_SECRET. Nunca el OTP real.
PASSWORD_RECOVERY_PEPPER=

# Resend (G05). Independiente de JWT_* y PASSWORD_RECOVERY_PEPPER.
# onboarding@resend.dev es SOLO para pruebas: con resend.dev solo se puede
# enviar al correo de la cuenta Resend. Producción requiere dominio verificado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Solo si la API necesita evadir RLS para procesos internos (usar con criterio).
# HU-02 la usa para Supabase Storage (bucket privado `perfiles`) — la API
# sube/lee documentos con esta key, App/Web nunca la reciben.
SUPABASE_SERVICE_ROLE_KEY=

# URL del proyecto Supabase (Project Settings > API > Project URL).
# Formato: https://<project-ref>.supabase.co — usada por @supabase/supabase-js
# solo para Storage, nunca para Auth/DB (eso sigue siendo DATABASE_URL directo).
SUPABASE_URL=

PORT=3000

# Orígenes permitidos (CORS) para el panel Web, separados por comas.
# Local: el dev server de Vite. En Render, agrega también la URL de Vercel.
CORS_ORIGINS=http://localhost:5173
